# Bunchy, production environment.
#
# Copy to `.env` on the server, fill it in, and keep it out of git. Docker
# Compose reads `.env` from the directory it runs in.
#
#   cp .env.production.example .env
#   chmod 600 .env
#
# Every value below is either required or has a sane default. The compose file
# fails loudly at `up` time if a required one is missing, rather than starting
# a half-configured stack.

# --- Domain -----------------------------------------------------------------
# Bare domain. Caddy serves this and www. automatically, and obtains
# certificates for both, so both must already resolve to this server.
DOMAIN=bunchy.app
# Where Let's Encrypt sends expiry warnings if renewal ever stops working.
TLS_EMAIL=you@example.com

# Used in emailed links (password reset, verification). Must be the public
# https URL, or people will be sent to a page that does not exist.
APP_URL=https://bunchy.app

# --- Database ---------------------------------------------------------------
# Postgres is not published outside the compose network, so this password
# guards lateral movement rather than the internet. Generate it, do not choose
# it:
#
#   openssl rand -hex 24
#
# Any password works, including one from a password manager: the containers
# percent-encode it when building the connection URL. Hex is suggested only
# because it is unambiguous to read back off a screen.
#
# Note that Postgres sets this password when the data volume is first created
# and never again. Changing it later means changing it in the running database
# too (`ALTER ROLE bunchy WITH PASSWORD '...'`), not just here.
POSTGRES_USER=bunchy
POSTGRES_PASSWORD=
POSTGRES_DB=bunchy

# There is deliberately no DATABASE_URL here. Each container assembles it from
# the three values above, so the password exists in exactly one place and
# cannot disagree with itself. Setting DATABASE_URL anyway overrides all of
# this, which is how you would point at a managed Postgres somewhere else.

# --- Secrets ----------------------------------------------------------------
# Salts hashed identifiers, including the banned-email fingerprints. Changing
# it after launch invalidates every session and every existing ban record, so
# generate it once and keep it:  openssl rand -base64 48
AUTH_SECRET=

# --- Email ------------------------------------------------------------------
# "console" writes mail to the container log and sends nothing. That is fine
# for a first smoke test and unacceptable once anyone but you has an account:
# password reset stops working and nobody can recover a lost login.
#
# Switch to "smtp" and fill in the four values below. Any provider works,
# Resend, Postmark, Mailgun, SES, Fastmail, because this speaks plain SMTP.
EMAIL_PROVIDER=console
EMAIL_FROM=Bunchy <hello@bunchy.app>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Pre-launch / maintenance gate ------------------------------------------
# Lets you hide the site from the public while still being able to see it
# yourself. Flip it with ./maintenance.sh (soon | on | off | status | link).
#
# This token is the bypass: visiting https://<DOMAIN>/?preview=<token> once
# sets a cookie that gets you past the gate for thirty days. Leave it unset and
# the gate still works, you just cannot get behind it, it fails closed.
#
#   PREVIEW_TOKEN=$(head -c 24 /dev/urandom | base64 | tr -d '/+=')
PREVIEW_TOKEN=""

# Signing secret for Resend's bounce and complaint webhook (whsec_...).
# Point Resend at https://<your-domain>/api/webhooks/resend and subscribe it to
# email.bounced and email.complained. Without this the endpoint refuses every
# request: an unsigned bounce report is a way for anybody to stop somebody
# else's password reset from being sent.
RESEND_WEBHOOK_SECRET=

# --- Discord bot (optional) ---------------------------------------------------
#
# Leave these empty and the bot container starts, logs that it has no token and
# exits zero. Nothing else in the product depends on it.
#
# Create the application at https://discord.com/developers/applications, add a
# bot, and invite it with the applications.commands and bot scopes. It needs the
# Server Members and Voice States privileged intents off, and Voice States on:
# presence reads voice state and nothing else. It never reads message content.
DISCORD_BOT_TOKEN=
# Right-click the server with developer mode on, Copy Server ID.
DISCORD_GUILD_ID=
# Optional again. Unset means the bot answers commands but announces nothing,
# which is the safer default for a channel you have not chosen yet.
DISCORD_ANNOUNCE_CHANNEL_ID=
