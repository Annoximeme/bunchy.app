# Local development defaults. Safe to commit: no real secrets live here.
# Override anything in `.env.local` (git-ignored).
DATABASE_URL="postgresql://bunchy:bunchy@127.0.0.1:5432/bunchy_dev?schema=public"
AI_PROVIDER="local"
EMAIL_PROVIDER="console"
EMAIL_FROM="Bunchy <hello@bunchy.app>"
APP_URL="http://localhost:3000"

# Scratch database used by `prisma migrate dev` / `migrate diff` to replay
# migrations. Must be a throwaway database — Prisma resets it.
SHADOW_DATABASE_URL="postgresql://bunchy:bunchy@127.0.0.1:5432/bunchy_shadow?schema=public"
