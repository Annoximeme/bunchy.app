# Local development defaults.
#
#   cp .env.example .env
#
# Nothing in here is a real secret — the database is a local one and the
# password is "bunchy". `.env` is git-ignored, so anything you add stays on
# your machine. For deploying to a server, use .env.production.example instead.

# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://bunchy:bunchy@127.0.0.1:5432/bunchy_dev?schema=public"

# --- Sessions ---------------------------------------------------------------
# 32+ random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required in production; a development fallback is used when unset locally.
AUTH_SECRET=""

# --- AI ---------------------------------------------------------------------
# There is nothing to configure. Bunchy's assistant is deterministic and runs
# in-process: no API key, no network call, no per-token cost at any scale.
# See src/server/modules/ai/provider.ts.

# --- App --------------------------------------------------------------------
APP_URL="http://localhost:3000"

# Scratch database for `prisma migrate dev` / `migrate diff`. Throwaway.
SHADOW_DATABASE_URL="postgresql://bunchy:bunchy@127.0.0.1:5432/bunchy_shadow?schema=public"

# --- Email -------------------------------------------------------------------
# "console" writes messages to the server log, which keeps verification and
# password-reset usable in development. Set "smtp" in production, or people who
# forget their password have no way back into their account.
EMAIL_PROVIDER=console
EMAIL_FROM="Bunchy <hello@bunchy.app>"
# Any transactional provider: Resend, Postmark, Mailgun, SES, Fastmail.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASSWORD=

# Signing secret for Resend's bounce and complaint webhook (whsec_...).
# Point Resend at https://<your-domain>/api/webhooks/resend and subscribe it to
# email.bounced and email.complained. Without this the endpoint refuses every
# request: an unsigned bounce report is a way for anybody to stop somebody
# else's password reset from being sent.
RESEND_WEBHOOK_SECRET=
