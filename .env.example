# Copy to .env.local and fill in. `.env` holds safe local-development defaults
# and is committed; `.env.local` is git-ignored and overrides it.

# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://bunchy:bunchy@127.0.0.1:5432/bunchy_dev?schema=public"

# --- Sessions ---------------------------------------------------------------
# 32+ random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required in production; a development fallback is used when unset locally.
AUTH_SECRET=""

# --- AI ---------------------------------------------------------------------
# Which assistant implementation to use: "local" (deterministic, no network,
# the default) or "anthropic".
AI_PROVIDER="local"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Email ------------------------------------------------------------------
# "console" writes verification/reset mail to stdout for local development.
EMAIL_PROVIDER="console"
EMAIL_FROM="Bunchy <hello@bunchy.app>"

# --- App --------------------------------------------------------------------
APP_URL="http://localhost:3000"

# Scratch database for `prisma migrate dev` / `migrate diff`. Throwaway.
SHADOW_DATABASE_URL="postgresql://bunchy:bunchy@127.0.0.1:5432/bunchy_shadow?schema=public"
