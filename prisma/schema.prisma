// Bunchy, database schema
//
// Design notes
// ------------
// 1. PII SEPARATION. `User` holds everything that identifies a real human
//    (email, password hash, birth year, auth material). `Profile` holds only
//    data that is safe to render to another member. Nothing in the discovery
//    surface reads from `User`. See src/server/modules/profile/serialize.ts,
//    it is the single sanctioned path from a database row to a public payload.
//
// 2. APPROXIMATE LOCATION ONLY. We never store a street address or precise
//    coordinates. `approxLat`/`approxLng` are snapped to a coarse grid
//    (see src/server/modules/geo/precision.ts) so distance-based matching
//    works without ever knowing where someone lives.
//
// 3. INTEREST INTENT. `UserInterest.intent` distinguishes "I already do this"
//    from "I want to get into this". This is what makes complementary matching
//    possible (experienced photographer <-> aspiring photographer) rather than
//    naive shared-tag counting.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity & authentication  (private, never serialized to other members)
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  /// Temporary, set by a moderator. `suspendedUntil` may be null for indefinite.
  SUSPENDED
  /// Permanent, set by an admin. Distinct from SUSPENDED so the two are
  /// separately auditable and separately reversible.
  BANNED
  /// The member deactivated themselves. Reversible by signing back in.
  DEACTIVATED
}

/// Staff privilege. Lives on `User` rather than `Profile` because it is
/// authorization data.
///
/// The level is never serialized. Profiles do show a plain "Staff" badge
/// derived from this, ADMIN and MODERATOR both flatten to one label, so a
/// member can verify that an account claiming to be staff is, which is the
/// other half of the impersonation defence that `Profile.title` starts. What
/// stays private is who holds which power.
enum UserRole {
  MEMBER
  /// Can work the report queue and act on content.
  MODERATOR
  /// Everything a moderator can do, plus users, roles and platform settings.
  ADMIN
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  emailVerifiedAt DateTime?
  /// Null for OAuth-only accounts. Never stores a plaintext password.
  passwordHash    String?
  /// Year and month, never the day.
  ///
  /// A full date of birth is the identifier used to open bank accounts; it is
  /// worth much more to whoever steals this database than it is to us. Year
  /// alone was not enough to state an age truthfully, a subtraction of years
  /// reads a year high until someone's birthday, so the month is stored and
  /// the day is not. The remaining error is the weeks before a birthday within
  /// the birth month itself.
  birthYear       Int?
  birthMonth      Int?
  status          UserStatus @default(ACTIVE)
  role            UserRole   @default(MEMBER)
  /// When a suspension lifts. Null on an indefinite suspension.
  suspendedUntil  DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  profile            Profile?
  sessions           Session[]
  oauthAccounts      OAuthAccount[]
  verificationTokens VerificationToken[]
  moderationActions  ModerationEvent[]   @relation("ModerationActor")
  supporter Supporter?

  @@index([status])
  @@index([role])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Staff audit trail
// ---------------------------------------------------------------------------

enum ModerationAction {
  USER_SUSPENDED
  USER_UNSUSPENDED
  USER_BANNED
  USER_UNBANNED
  USER_ROLE_CHANGED
  REPORT_ACTIONED
  REPORT_DISMISSED
  REPORT_REVIEWING
  BUNCH_ARCHIVED
  BUNCH_RESTORED
  ACTIVITY_CANCELLED
  BUNCH_MESSAGE_REMOVED
  INTEREST_APPROVED
  INTEREST_REJECTED
  INTEREST_UPDATED
  INTEREST_MERGED
  /// A staff member created a bunch from a formation proposal and invited
  /// its members. Invitations, not memberships, but a dozen people getting a
  /// notification because of one click belongs in the audit trail.
  BUNCH_PROPOSED
  /// An admin took the public site down or put it back up. The widest-reaching
  /// action in the dashboard, so it is the one most worth being able to
  /// attribute afterwards.
  SITE_GATE_CHANGED
  /// An announcement went out to every member. Reaches more people than any
  /// moderation action, and two of the tiers exist to satisfy a promise made in
  /// the policies, so who sent what, and when, has to be attributable.
  ANNOUNCEMENT_PUBLISHED
  ANNOUNCEMENT_WITHDRAWN
}

/// Every staff action, recorded before it is taken.
///
/// Moderation power without an audit trail is how a platform quietly becomes
/// unaccountable, so nothing in the admin module mutates state without writing
/// one of these first. The actor is denormalized alongside the foreign key so
/// the record survives the staff account being deleted.
model ModerationEvent {
  id          String           @id @default(cuid())
  action      ModerationAction
  actorUserId String?
  /// Who did it, captured at the time. Survives account deletion.
  actorLabel  String
  targetType  String
  targetId    String
  reason      String?
  /// Free-form context: previous values, counts, merge targets.
  metadata    Json?
  createdAt   DateTime         @default(now())

  actor User? @relation("ModerationActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId])
  @@index([targetType, targetId])
  @@index([action])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  /// SHA-256 of the opaque session token. The raw token exists only in the
  /// user's cookie, so a database leak does not hand out live sessions.
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  userAgent  String?
  /// Hashed, never the raw IP.
  ipHash     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model VerificationToken {
  id         String              @id @default(cuid())
  userId     String
  purpose    VerificationPurpose
  tokenHash  String              @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Public profile
// ---------------------------------------------------------------------------

enum OnboardingStage {
  BASICS
  INTERESTS
  PERSONALITY
  GOALS
  AVAILABILITY
  COMPLETE
}

model Profile {
  id          String  @id @default(cuid())
  userId      String  @unique
  username    String  @unique
  displayName String
  bio         String?
  avatarUrl   String?

  // Approximate location. `cityLabel` is a populated-place label such as
  // "Antwerp", never a street. Coordinates are grid-snapped.
  countryCode String?
  regionLabel String?
  cityLabel   String?
  approxLat   Float?
  approxLng   Float?
  /// IANA zone, e.g. "Europe/Brussels". Null means we don't know and fall back
  /// to UTC, availability windows are local ideas, and comparing the labels
  /// directly told a member in Antwerp they were free at the same time as a
  /// member in Tokyo.
  timezone    String?

  onboardingStage OnboardingStage @default(BASICS)
  onboardedAt     DateTime?

  /// Awarded once, at the moment onboarding completes, while the member base is
  /// still under `FOUNDING_MEMBER_LIMIT`. Stored rather than derived so it can
  /// never be recalculated away, and deliberately a boolean rather than an
  /// ordinal: "here since the beginning" is a fact, "founding member #47" is a
  /// leaderboard, and §29 rules out numbers that rank one member above another.
  foundingMember  Boolean @default(false)

  /// A staff title such as "Founder & Developer of Bunchy", shown as a badge on
  /// the profile.
  ///
  /// Deliberately NOT member-editable. A free-text line rendered in a badge is
  /// an impersonation surface, anyone could write "Bunchy Support" and ask a
  /// member for their password. It is set from the CLI
  /// (`scripts/set-title.ts`), which means it requires database access, the
  /// same bar as granting the first admin (§13).
  ///
  /// Not the same thing as `foundingMember`: that is a fact about when someone
  /// arrived and confers nothing. This says what someone does here.
  title String?

  /// Stable, shareable, and not the username, usernames can change and a
  /// printed invite link should not rot when they do.
  referralCode String? @unique
  /// Who invited them, if anyone. Set once at signup and never editable.
  referredById String?
  lastActiveAt    DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SetNull, not Cascade: someone deleting their account must not delete the
  /// people they invited.
  referredBy Profile?  @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referred   Profile[] @relation("Referrals")

  personality  PersonalityProfile?
  privacy      PrivacySettings?
  interests    UserInterest[]
  goals        ProfileSocialGoal[]
  availability ProfileAvailability[]
  /// The live "I'm free right now" status, if they have set one. At most one.
  availabilityStatus AvailabilityStatus?
  plansCreated       SocialPlan[]       @relation("PlanCreator")
  planVotes          SocialPlanVote[]   @relation("PlanVoter")
  icebreakersAsked   IcebreakerAsk[]    @relation("IcebreakerAsker")
  challengesStarted  BunchChallenge[]   @relation("ChallengeStarter")

  sentConnections     Connection[] @relation("ConnectionRequester")
  receivedConnections Connection[] @relation("ConnectionAddressee")

  conversations    ConversationParticipant[]
  directMessages   DirectMessage[]
  bunchMemberships BunchMembership[]
  bunchMessages   BunchMessage[]
  createdBunches   Bunch[]                  @relation("BunchCreator")
  reactions        MessageReaction[]
  mentions         MessageMention[]

  organizedActivities Activity[]            @relation("ActivityOrganizer")
  activityEntries     ActivityParticipant[]
  activityOutcomes    ActivityOutcome[]
  moderatorApplication ModeratorApplication?

  blocksMade     Block[] @relation("Blocker")
  blocksReceived Block[] @relation("Blocked")
  reportsMade    Report[] @relation("Reporter")
  reportsAbout   Report[] @relation("ReportedProfile")

  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  recommendations         Recommendation[]      @relation("RecommendationOwner")
  matchFeedbackGiven      MatchFeedback[]       @relation("FeedbackAuthor")
  matchFeedbackReceived   MatchFeedback[]       @relation("FeedbackSubject")
  analyticsEvents         AnalyticsEvent[]
  announcementReads  AnnouncementRead[]
  announcementEmails AnnouncementEmail[]
  seriesOrganised    ActivitySeries[]       @relation("SeriesOrganizer")
  seriesMemberships  ActivitySeriesMember[]
  discordLink        DiscordLink?
  discordLinkCodes   DiscordLinkCode[]

  @@index([cityLabel])
  @@index([countryCode, regionLabel])
  @@index([lastActiveAt])
  @@index([referredById])
  @@index([onboardingStage])
}

/// Seven lightweight axes, each 0-100. Collected through a handful of
/// either/or questions during onboarding, never presented as a personality test.
model PersonalityProfile {
  profileId String @id

  /// 0 = strongly introvert, 100 = strongly extrovert
  introversionExtraversion Int @default(50)
  /// 0 = spontaneous, 100 = planned
  spontaneityPlanning      Int @default(50)
  /// 0 = competitive, 100 = relaxed
  competitiveRelaxed       Int @default(50)
  /// 0 = deep conversation, 100 = casual conversation
  deepCasual               Int @default(50)
  /// 0 = online-first, 100 = offline-first
  onlineOffline            Int @default(50)
  /// 0 = small groups, 100 = large groups
  smallLargeGroups         Int @default(50)
  /// 0 = night owl, 100 = morning person
  nightMorning             Int @default(50)

  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

enum AudienceScope {
  EVERYONE
  CONNECTIONS
  BUNCH_MEMBERS
  NOBODY
}

model PrivacySettings {
  profileId String @id

  whoCanMessage        AudienceScope @default(CONNECTIONS)
  whoCanSendRequests   AudienceScope @default(EVERYONE)
  /// When false the profile is hidden from Discover entirely.
  discoverable         Boolean       @default(true)
  /// When false we show country/region only, never the city label.
  showApproxLocation   Boolean       @default(true)
  invitableToBunches   Boolean       @default(true)
  /// When false the profile renders an age band ("25-34") instead of an age.
  showExactAge         Boolean       @default(true)
  /// Whether Bunchy may offer introductions to compatible people (§5).
  ///
  /// Separate from `discoverable`: someone can be happy to be found in search
  /// and still not want the product proposing people to them unprompted. The
  /// two questions have genuinely different answers, so they get two switches.
  aiIntroductions      Boolean       @default(true)
  /// Who may see a "Who's Up" status, when one is set.
  ///
  /// EVERYONE by default, which sounds like the wrong choice and is not. The
  /// audience is already bounded by `discoverable` above, "everyone" here means
  /// the same people who can find this member in Discover today, not the public
  /// internet. Defaulting to CONNECTIONS would instead make the feature
  /// pointless: the candidate query for Find Someone excludes people you are
  /// already connected to, so a connections-only status would be visible to
  /// precisely nobody who could act on it, while still looking like it worked.
  ///
  /// The opt-in is the act of setting a status, which is explicit and expires.
  /// NOBODY switches the feature off outright (§4).
  whoCanSeeAvailability AudienceScope @default(EVERYONE)

  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Interests, goals, availability
// ---------------------------------------------------------------------------

enum InterestStatus {
  /// Part of the curated catalog, or reviewed and kept.
  APPROVED
  /// Member-created and not yet reviewed. Usable, but not suggested to others.
  PENDING
  /// Reviewed and rejected. Hidden from pickers and browsing.
  REJECTED
}

model Interest {
  id       String  @id @default(cuid())
  slug     String  @unique
  label    String
  category String
  /// Shown in the picker to explain what a tag actually covers.
  description String?
  /// Alternative spellings, so "boardgames" finds "Board games".
  aliases  String[] @default([])
  /// Custom interests are member-created and start unverified.
  isCustom Boolean @default(false)
  status   InterestStatus @default(APPROVED)
  /// Denormalized popularity counter, used to surface established tags first.
  usageCount Int   @default(0)
  createdAt DateTime @default(now())

  users   UserInterest[]
  bunches BunchInterest[]

  @@index([category])
  @@index([usageCount])
  @@index([status])
}

enum InterestIntent {
  /// "I already do this."
  PRACTICES
  /// "I want to get into this.", the other half of complementary matching.
  CURIOUS
}

model UserInterest {
  profileId  String
  interestId String
  /// 1 = casual, 2 = into it, 3 = it's my thing
  strength   Int            @default(2)
  intent     InterestIntent @default(PRACTICES)
  createdAt  DateTime       @default(now())

  profile  Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([profileId, interestId])
  @@index([interestId])
  @@index([profileId, intent])
}

enum SocialGoal {
  NEW_FRIENDS
  GAMING_FRIENDS
  HOBBY_PARTNERS
  GOING_OUT
  STUDY_PARTNERS
  FITNESS_PARTNERS
  CREATIVE_COLLABORATORS
  BUSINESS_PARTNERS
  MENTORS
  SIMILAR_INTERESTS
  LOCAL_COMMUNITIES
  TRAVEL_COMPANIONS
  ACTIVITY_PARTNERS
}

model ProfileSocialGoal {
  profileId String
  goal      SocialGoal

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, goal])
  @@index([goal])
}

enum AvailabilityWindow {
  WEEKDAY_MORNING
  WEEKDAY_AFTERNOON
  WEEKDAY_EVENING
  WEEKEND_MORNING
  WEEKEND_AFTERNOON
  WEEKEND_EVENING
  LATE_NIGHT
}

model ProfileAvailability {
  profileId String
  window    AvailabilityWindow

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, window])
  @@index([window])
}

// ---------------------------------------------------------------------------
// Connections (mutual consent) and direct messaging
// ---------------------------------------------------------------------------

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

model Connection {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      ConnectionStatus @default(PENDING)
  /// Optional short note attached to the request. Rate limited, length capped.
  note        String?
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  requester Profile @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee Profile @relation("ConnectionAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  conversation Conversation?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

model Conversation {
  id            String   @id @default(cuid())
  connectionId  String?  @unique
  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  connection   Connection?               @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     DirectMessage[]

  @@index([lastMessageAt])
}

model ConversationParticipant {
  conversationId String
  profileId      String
  lastReadAt     DateTime?
  joinedAt       DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  profile      Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([conversationId, profileId])
  @@index([profileId])
}

model DirectMessage {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       Profile      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

// ---------------------------------------------------------------------------
// Bunches
// ---------------------------------------------------------------------------

enum BunchType {
  INTEREST
  LOCAL
  ACTIVITY
}

enum BunchVisibility {
  /// Discoverable; joining creates a request a moderator approves.
  PUBLIC
  /// Invite only, hidden from Discover.
  PRIVATE
}

enum BunchRole {
  MEMBER
  MODERATOR
  OWNER
}

enum MembershipStatus {
  ACTIVE
  /// Member asked to join, awaiting moderator approval.
  REQUESTED
  /// Moderator invited them, awaiting their acceptance.
  INVITED
  LEFT
  REMOVED
}

model Bunch {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  description String
  imageUrl    String?
  type        BunchType       @default(INTEREST)
  visibility  BunchVisibility @default(PUBLIC)

  countryCode String?
  regionLabel String?
  cityLabel   String?
  approxLat   Float?
  approxLng   Float?

  /// Bunches are deliberately small. Enforced in the membership service.
  maxMembers Int     @default(12)
  rules      String?

  createdById String?
  /// Rolling 0-1 measure of how alive the bunch is. Recomputed, never shown
  /// as a leaderboard rank.
  activityScore Float    @default(0)
  archivedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy   Profile?           @relation("BunchCreator", fields: [createdById], references: [id], onDelete: SetNull)
  /// Moderators can switch challenges off for their bunch (§12). Icebreakers
  /// need no such flag, they are only ever posted by someone pressing a
  /// button, so "off" is simply not pressing it.
  challengesEnabled Boolean @default(true)

  interests   BunchInterest[]
  memberships BunchMembership[]
  chemistry   BunchChemistry?
  messages    BunchMessage[]
  activities  Activity[]
  series      ActivitySeries[]
  plans       SocialPlan[]
  icebreakers IcebreakerAsk[]
  challenges  BunchChallenge[]

  @@index([visibility, archivedAt])
  @@index([cityLabel])
  @@index([type])
  @@index([activityScore])
}

model BunchInterest {
  bunchId   String
  interestId String

  bunch   Bunch   @relation(fields: [bunchId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([bunchId, interestId])
  @@index([interestId])
}

model BunchMembership {
  bunchId  String
  profileId String
  role      BunchRole       @default(MEMBER)
  status    MembershipStatus @default(ACTIVE)
  joinedAt  DateTime         @default(now())
  lastReadAt DateTime?

  bunch  Bunch  @relation(fields: [bunchId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([bunchId, profileId])
  @@index([profileId, status])
  @@index([bunchId, status])
}

enum BunchMessageKind {
  TEXT
  /// "Ana joined the bunch", "Activity scheduled", rendered differently,
  /// never notified as if a person spoke.
  SYSTEM
  /// An icebreaker question or a challenge, posted into the chat by a member
  /// pressing a button. Distinct from SYSTEM because a person chose to ask it,
  /// and distinct from TEXT because nobody wrote the words.
  PROMPT
}

model BunchMessage {
  id       String            @id @default(cuid())
  bunchId String
  authorId String?
  kind     BunchMessageKind @default(TEXT)
  body     String
  parentId String?
  createdAt DateTime         @default(now())
  editedAt  DateTime?
  deletedAt DateTime?
  /// Set when a moderator removes the message.
  moderatedAt DateTime?

  bunch    Bunch            @relation(fields: [bunchId], references: [id], onDelete: Cascade)
  author    Profile?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parent    BunchMessage?    @relation("MessageReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies   BunchMessage[]   @relation("MessageReplies")
  reactions MessageReaction[]
  mentions  MessageMention[]

  @@index([bunchId, createdAt])
  @@index([parentId])
  @@index([authorId])
}

model MessageReaction {
  messageId String
  profileId String
  emoji     String
  createdAt DateTime @default(now())

  message BunchMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  profile Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([messageId, profileId, emoji])
  @@index([profileId])
}

model MessageMention {
  messageId String
  profileId String

  message BunchMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  profile Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([messageId, profileId])
  @@index([profileId])
}

// ---------------------------------------------------------------------------
// Activities, the point of the product is that people actually do things
// ---------------------------------------------------------------------------

/// How often a ritual comes round.
///
/// Deliberately short. A schedule expressive enough to describe anything is a
/// schedule nobody can read back, and the thing being modelled here is "our
/// Thursday", not a calendar system.
enum SeriesCadence {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

/// A thing a group does again and again.
///
/// The product had no way to say "every Thursday". Every activity was a
/// separate one-off, so a group that met weekly had to recreate it weekly, and
/// the fact that these were the same people doing the same thing existed only
/// in their heads. This is the row that holds it.
///
/// ## Why `nextAt` rather than a weekday and a time
///
/// Storing "Thursdays at 20:00" means resolving a weekday and a wall-clock time
/// against somebody's timezone every time an occurrence is generated, which is
/// where recurring-event systems go wrong: the hour drifts across daylight
/// saving, or the day does. `nextAt` is a concrete instant, the same kind of
/// value `Activity.startsAt` already is. The job materialises it and advances
/// it by one cadence step. There is no second representation of time to keep
/// in agreement with the first.
///
/// ## Membership is separate from attendance
///
/// Joining the series says "this is my Thursday". Joining an occurrence says
/// "I am coming this week". They are different promises and the product needs
/// both, so `ActivitySeriesMember` is not the same thing as
/// `ActivityParticipant`. Someone can hold the ritual and miss a week without
/// leaving, which is how a standing arrangement actually works.
model ActivitySeries {
  id          String  @id @default(cuid())
  title       String
  description String

  cadence SeriesCadence
  /// The instant the next occurrence starts. Advanced by the job as it goes.
  nextAt  DateTime
  /// How long an occurrence runs, carried onto each one.
  durationMinutes Int?

  /// Online by default.
  ///
  /// Defaults are the strongest opinion a product has, because most people
  /// never change them, and this one used to say the quiet part: in person is
  /// the real thing and online is the variant. Online activities need fewer
  /// things to line up (somebody awake, rather than somebody nearby AND free
  /// AND willing to travel), so they are the ones that can actually fill at
  /// launch density. The default should point at the one that works.
  mode          ActivityMode @default(ONLINE)
  locationLabel String?
  onlineUrl     String?
  maxParticipants Int        @default(8)

  organizerId String
  bunchId     String?

  /// Set when the ritual is ended. The row and its history stay: a bunch that
  /// met every Thursday for a year did that, and deleting the series would
  /// delete the only record of it.
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  organizer   Profile                @relation("SeriesOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  bunch       Bunch?                 @relation(fields: [bunchId], references: [id], onDelete: SetNull)
  occurrences Activity[]
  members     ActivitySeriesMember[]

  @@index([nextAt])
  @@index([organizerId])
  @@index([bunchId])
}

/// Somebody who holds a standing arrangement, rather than one evening of it.
model ActivitySeriesMember {
  seriesId  String
  profileId String
  joinedAt  DateTime @default(now())

  series  ActivitySeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  profile Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([seriesId, profileId])
  @@index([profileId])
}

/// A Discord account somebody has proved is theirs.
///
/// The foundation the rest of the bot needs. Announcing activities needs no
/// link, but a slash command that sets *your* status, or voice presence that
/// says *who* is in a channel, is impossible without knowing which Discord user
/// is which member. Building those first and bolting identity on afterwards is
/// how a bot ends up trusting a username.
///
/// ## How the proof works
///
/// The member asks for a code in Bunchy and types it at the bot, rather than
/// the reverse. That direction matters: the session is the thing that already
/// proves who they are, so the code only has to carry that proof outward. A
/// bot-issued code redeemed on the site would instead be proving Discord
/// identity to Bunchy, which is the same problem pointed the wrong way and
/// needs OAuth to do properly.
///
/// Codes are short-lived and single-use, stored hashed like every other token
/// in this codebase, and one link per member and per Discord account.
model DiscordLink {
  profileId String @id
  /// The Discord snowflake. Unique, so one Discord account cannot claim two
  /// members, which is what would make presence ambiguous.
  discordId String @unique
  /// Kept for display in staff tooling only. Discord handles change; the id
  /// does not, and nothing is ever matched on this.
  username  String?

  linkedAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

/// A short-lived code proving a Bunchy session, to be typed at the bot.
///
/// Hashed at rest, like sessions and email tokens, so the table is not a list
/// of working credentials. Deleted on redemption rather than marked used: an
/// unredeemed code that has expired is worth nothing and the row is noise.
model DiscordLinkCode {
  codeHash  String   @id
  profileId String
  expiresAt DateTime
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([expiresAt])
}

/// Bot settings an admin can change without a deploy.
///
/// A single row, because there is one bot. The alternative is a generic
/// key-value settings table, which is a schema that describes nothing and a
/// place every future feature dumps a string into.
///
/// ## Why these are not environment variables
///
/// The token and the guild id stay in the environment: they are secrets or
/// near-secrets, they are set once, and changing them is a deploy anyway.
/// These two are neither. Choosing where to announce and switching
/// announcements off are things an operator wants to do at the moment the
/// channel is wrong or the noise is unwelcome, which is exactly when editing a
/// file on a server and redeploying is the least likely thing to happen.
model BotSettings {
  /// Always "default". A guard against a second row appearing and the product
  /// quietly reading whichever came back first.
  id String @id @default("default")

  /// Where open calls are posted. Null means announcements are off.
  announceChannelId String?
  /// Kept for display so the admin page can name the channel without a round
  /// trip to Discord. Never matched on.
  announceChannelName String?

  /// Off without clearing the channel, so switching announcements back on does
  /// not mean choosing where all over again.
  announcementsEnabled Boolean @default(true)

  /// Whether occurrences of a standing arrangement are announced as well.
  announceSeries Boolean @default(true)

  /// Where somebody new is greeted. Null means nobody is greeted.
  welcomeChannelId   String?
  welcomeChannelName String?

  /// Where the rules live.
  rulesChannelId   String?
  rulesChannelName String?
  /// The message the rules were posted as.
  ///
  /// Kept so re-publishing edits that message rather than posting a second
  /// copy. A rules channel with three versions of the rules in it is worse
  /// than one with none, because the reader has to work out which is current.
  rulesMessageId   String?

  updatedAt DateTime @updatedAt
}

enum ActivityMode {
  ONLINE
  OFFLINE
}

enum ActivityStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
  /// An open call that nobody took up before its window closed.
  ///
  /// A status rather than a deletion, and that is the whole design. `instant.ts`
  /// refuses to make bunches temporary because "adding a temporary flag would
  /// mean writing the code that deletes people's groups", and that reasoning
  /// holds. This is not a group: it is an offer somebody made for one evening,
  /// and an offer that goes unanswered can quietly close without anything
  /// anybody built being removed. The row, and the fact that they asked, stay.
  EXPIRED
}

model Activity {
  id          String         @id @default(cuid())
  title       String
  description String
  startsAt    DateTime
  endsAt      DateTime?
  mode        ActivityMode   @default(ONLINE)
  /// Venue-level label only ("Bar Bassin, Antwerp"), never a home address.
  locationLabel String?
  countryCode   String?
  cityLabel     String?
  /// For ONLINE activities: where to meet (Discord, Steam, a link).
  onlineUrl     String?
  maxParticipants Int          @default(8)
  status          ActivityStatus @default(SCHEDULED)
  organizerId     String
  bunchId        String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  /// The ritual this is an occurrence of, if it is one. Null for a one-off.
  seriesId        String?

  /// When this was posted to Discord, if it was.
  ///
  /// Exactly-once, and restart-safe, which an in-memory marker is not. The
  /// announcer previously kept a `since` timestamp in the process: good enough
  /// for quick calls, which enter the window once, and wrong for an occurrence
  /// of a standing arrangement, which sits in "on today" for hours and would
  /// have been posted on every five-minute pass until it started.
  discordAnnouncedAt DateTime?

  /// When an open call stops being open. Null for an ordinary plan.
  ///
  /// Only set on a quick call: "anyone want to play right now". Those are made
  /// on impulse for a window that closes, and one left lying around a week
  /// later is worse than no answer at all, because it reads as a room nobody
  /// came to. Reaching this with nobody joined moves the status to EXPIRED.
  expiresAt       DateTime?

  organizer    Profile               @relation("ActivityOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  series       ActivitySeries?       @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  bunch       Bunch?               @relation(fields: [bunchId], references: [id], onDelete: SetNull)
  participants ActivityParticipant[]
  outcomes     ActivityOutcome[]
  /// The plan this came out of, when it came out of one.
  plan         SocialPlan?

  @@index([startsAt, status])
  @@index([bunchId])
  @@index([organizerId])
  @@index([cityLabel, startsAt])
}

enum ParticipationStatus {
  JOINED
  WAITLISTED
  LEFT
}

model ActivityParticipant {
  activityId String
  profileId  String
  status     ParticipationStatus @default(JOINED)
  joinedAt   DateTime            @default(now())

  /// When a Discord reminder went out for this person and this activity.
  ///
  /// On the participant rather than the activity, because the reminder is to a
  /// person about their own commitment: two people joining the same evening
  /// each get one, and one of them unlinking does not silence the other.
  discordRemindedAt DateTime?

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  profile  Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([activityId, profileId])
  @@index([profileId, status])
  @@index([activityId, status])
}

/// What actually happened.
///
/// Bunchy measures whether someone met a person, not how long they stayed on
/// the site, and until this table existed, that measurement did not exist
/// either. Every other signal in the schema is about intent: who was
/// recommended, who joined, who said they were free. This is the only one about
/// outcome, which makes it the only honest input to whether the matching works.
///
/// Two questions, both optional to answer and both answerable in one tap.
/// Anything longer is a survey, and a survey after a night out is a survey
/// nobody fills in.
/// Someone offering to work the report queue.
///
/// Kept as its own record rather than an email in an inbox: an application that
/// lives in a mailbox gets lost, and the person who wrote it is left wondering
/// for a month whether anybody read it. One per profile, so applying is not
/// something that can be done repeatedly to get attention.
///
/// Deliberately tied to a member rather than open to anonymous submissions. A
/// moderator has to be someone with a history here, and it means the form never
/// collects a name or an email we already have.
model ModeratorApplication {
  id        String                     @id @default(cuid())
  profileId String                     @unique
  /// Roughly how much time they expect to give, in hours per week. Stored so
  /// nobody is quietly rostered for more than they offered.
  hoursPerWeek Int
  /// Why they want to do it, in their words.
  motivation   String
  /// Anything relevant they have done before. Optional, most good moderators
  /// have never been one.
  experience   String?
  /// They confirmed they understand the queue contains harassment, scams and
  /// reported private messages. Recorded because consent to see that is the
  /// one thing this form genuinely needs.
  acknowledgedExposure Boolean @default(false)

  status     ModeratorApplicationStatus @default(NEW)
  reviewedAt DateTime?
  reviewNote String?
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

enum ModeratorApplicationStatus {
  NEW
  REVIEWING
  ACCEPTED
  DECLINED
  /// They asked to be taken off the list, or stepped down.
  WITHDRAWN
}

model ActivityOutcome {
  id         String   @id @default(cuid())
  activityId String
  profileId  String

  /// Did they actually go. Null while unanswered.
  attended   Boolean?
  /// Did they meet someone they would see again. Deliberately not "did you
  /// enjoy it": enjoyment is a rating, and a rating of an evening is a rating of
  /// the people who were at it.
  metSomeone Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  profile  Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  /// One answer per person per activity; answering again edits it.
  @@unique([activityId, profileId])
  @@index([profileId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Trust & safety
// ---------------------------------------------------------------------------

model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker Profile @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked Profile @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

enum ReportTargetType {
  PROFILE
  BUNCH_MESSAGE
  DIRECT_MESSAGE
  BUNCH
  ACTIVITY
}

enum ReportReason {
  HARASSMENT
  SPAM
  HATE_SPEECH
  SEXUAL_CONTENT
  SCAM_OR_FRAUD
  IMPERSONATION
  SELF_HARM
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  ACTIONED
  DISMISSED
}

model Report {
  id         String           @id @default(cuid())
  /// Nullable so a report outlives its reporter. If someone reports harassment
  /// and then deletes their account, cascading the report away would quietly
  /// clear the queue and let the reported member escape review. The report is
  /// anonymized instead, the safety record survives, the person does not.
  reporterId String?
  targetType ReportTargetType
  targetId   String
  /// Denormalized for profile reports so moderators can act without a join.
  reportedProfileId String?
  reason     ReportReason
  details    String?
  status     ReportStatus     @default(OPEN)
  createdAt  DateTime         @default(now())
  reviewedAt DateTime?
  reviewNote String?

  reporter        Profile? @relation("Reporter", fields: [reporterId], references: [id], onDelete: SetNull)
  reportedProfile Profile? @relation("ReportedProfile", fields: [reportedProfileId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId])
  @@index([reportedProfileId])
}

// ---------------------------------------------------------------------------
// Analytics
// ---------------------------------------------------------------------------

/// A product event.
///
/// The operational tables record the *current state* of the world; this records
/// what happened and when, which is the only way to answer cohort questions
/// ("of the people who joined in week 3, how many came back on day 7?").
///
/// Two constraints shape the design:
///
/// 1. **No PII.** An event carries a profile reference and structured
///    properties, never an email, a name or a coordinate. Anything identifying
///    is looked up through the profile at query time, so exporting this table
///    cannot leak a member.
/// 2. **Deleted with the member.** The profile relation cascades, so erasing an
///    account erases its event history too. That does mean historical aggregates
///    shift slightly when someone leaves, the right trade for a product that
///    promises real data control.
model AnalyticsEvent {
  id   String @id @default(cuid())
  /// Dotted name from the taxonomy in src/server/modules/analytics/events.ts.
  name String
  /// Null before a profile exists (a signup is attributed on the next event).
  profileId String?
  /// Structured context. Never free text a member typed.
  properties Json?
  /// Acquisition attribution, captured once at signup.
  source     String?
  campaign   String?
  occurredAt DateTime @default(now())

  profile Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([name, occurredAt])
  @@index([profileId, occurredAt])
  @@index([occurredAt])
}

/// Fixed-window rate limit counters. The store is behind an interface
/// (src/server/ratelimit) so this can move to Redis without touching callers.
/// Addresses that may not create a new account.
///
/// Deleting an account frees its email address, so without this a banned
/// member deletes and re-registers in one click and every block, report and
/// moderation decision about them is void. That harms the people they were
/// banned for harassing more than retaining one hash harms them.
///
/// Three deliberate constraints keep it proportionate:
///
/// 1. **No foreign key to `User`.** That is the entire point, a cascade would
///    take the row with the account, which is exactly the evasion path.
/// 2. **Only a keyed hash, never the address.** HMAC-SHA256 under `AUTH_SECRET`,
///    so a copy of this table alone cannot tell anyone whether a given person
///    was banned, and nothing here can be read back into an email.
/// 3. **Only bans.** Suspensions and voluntary deletions never write here, and
///    lifting a ban removes the row.
model BannedEmail {
  /// HMAC-SHA256 of the normalized address. Never the address itself.
  emailHash String   @id
  bannedAt  DateTime @default(now())
  /// Why, for a moderator reviewing an appeal. Never identifies the person.
  reason    String?

  @@index([bannedAt])
}

model RateLimitCounter {
  key         String
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime

  @@id([key, windowStart])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

enum NotificationType {
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  DIRECT_MESSAGE
  BUNCH_INVITE
  BUNCH_JOIN_REQUEST
  BUNCH_MESSAGE_REPLY
  BUNCH_MENTION
  BUNCH_RECOMMENDATION
  ACTIVITY_INVITE
  ACTIVITY_REMINDER
  ACTIVITY_CHANGED
  /// "Did you go?", the only notification sent after something, rather than
  /// before it. See ActivityOutcome.
  ACTIVITY_FOLLOW_UP
}

model Notification {
  id        String           @id @default(cuid())
  profileId String
  type      NotificationType
  title     String
  body      String?
  linkPath  String?
  /// Collapses duplicates: one "3 new messages" row, not three rows.
  groupKey  String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, readAt, createdAt])
  @@index([profileId, groupKey])
}

// Deliberately no column defaults. The default for an untouched setting lives
// in `defaultPreference()` and depends on the type, which the database cannot
// express, a blanket `@default(true)` here once meant a member could be
// opted into suggestions the settings screen showed as off. Without a column
// default Prisma requires both values on insert, so the omission is a compile
// error rather than a silent subscription.
model NotificationPreference {
  profileId String
  type      NotificationType
  inApp     Boolean
  email     Boolean

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, type])
}

// ---------------------------------------------------------------------------
// Matching output & feedback
// ---------------------------------------------------------------------------

enum RecommendationKind {
  PERSON
  BUNCH
  ACTIVITY
}

model Recommendation {
  id        String             @id @default(cuid())
  profileId String
  kind      RecommendationKind
  targetId  String
  score     Float
  /// Human-readable signal breakdown from the scorer, kept so we can explain
  /// a recommendation and audit scorer changes over time.
  reasons   Json
  /// Identifies which scorer produced this ("deterministic@1", "llm@...").
  source    String
  createdAt DateTime           @default(now())
  expiresAt DateTime
  dismissedAt DateTime?
  actedAt     DateTime?

  profile Profile @relation("RecommendationOwner", fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, kind, targetId])
  @@index([profileId, kind, score])
  @@index([expiresAt])
}

enum MatchFeedbackSignal {
  GOOD_MATCH
  NOT_INTERESTED
}

/// Explicit "this was/wasn't a good suggestion" feedback. Feeds straight back
/// into scoring, and is the training set for a future learned ranker.
model MatchFeedback {
  id        String              @id @default(cuid())
  profileId String
  targetId  String
  signal    MatchFeedbackSignal
  createdAt DateTime            @default(now())

  profile Profile @relation("FeedbackAuthor", fields: [profileId], references: [id], onDelete: Cascade)
  target  Profile @relation("FeedbackSubject", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([profileId, targetId])
  @@index([targetId])
}

// ---------------------------------------------------------------------------
// Who's Up
// ---------------------------------------------------------------------------

enum AvailabilityKind {
  FREE_NOW
  FREE_TONIGHT
  FREE_THIS_WEEKEND
  LOOKING_FOR_SOMETHING
  LOOKING_FOR_PEOPLE
  UP_FOR_GAMING
  UP_FOR_ACTIVITIES
  OPEN_TO_MEETING
  /// Added for Bunchy Now. Same machinery as the rest, one row per member,
  /// always expiring, just more specific about what someone is up for, because
  /// "up for something" and "up for a match tonight" find different people.
  UP_FOR_FOOD
  UP_FOR_SPORTS
  UP_FOR_NIGHTLIFE
  UP_FOR_SPONTANEOUS
}

/// A member saying "I'm free, come find me", for a while.
///
/// Keyed on the profile rather than given its own id, so there is exactly one
/// live status per person and setting a new one replaces the old. That is not a
/// storage optimisation: a table of every status anyone ever set would be a
/// history of when each member was at a loose end, which is precisely the
/// permanent availability record §4 rules out. There is nothing to purge
/// because nothing accumulates.
///
/// `expiresAt` is required and enforced at the service layer. A status without
/// one is a beacon, and this feature is not a beacon.
model AvailabilityStatus {
  profileId String           @id
  kind      AvailabilityKind
  /// The member's own words, e.g. "up for a board game night". Optional,
  /// length-capped, and reportable like any other member-written text.
  note      String?
  /// What the status is about, so "available for gaming" can be filtered on.
  /// A plain id array rather than a join table: these rows are ephemeral, and
  /// an id left dangling by an interest merge disappears when the status does.
  interestIds String[] @default([])
  /// Null when they did not say. Never inferred.
  mode      ActivityMode?

  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([kind, expiresAt])
}

// ---------------------------------------------------------------------------
// Bunch chemistry
// ---------------------------------------------------------------------------

/// The latest chemistry reading for a bunch.
///
/// Keyed on the bunch, so there is one row per group and it is replaced rather
/// than appended. A table of every reading ever taken would be a record of each
/// group's decline, which is not something this product should be able to hand
/// anybody, and `previousScore` covers the only comparison the feature needs
/// ("more active than last week") without keeping a history.
///
/// Written by the scheduled job, never during a page render. Computing it means
/// loading every member's match profile and scoring every pair; measured at
/// 78ms against 4ms for the rest of the bunch page, which is exactly the sort of
/// thing §21 says to precompute.
model BunchChemistry {
  bunchId    String   @id
  /// 0-100, or null when there is genuinely not enough evidence yet.
  score      Int?
  /// The reading before this one, for "up from last week". Never a series.
  previousScore Int?
  /// "none" | "low" | "good", how much the number should be trusted.
  confidence String
  /// Per-signal breakdown, as the pure scorer produced it.
  signals    Json
  /// Plain sentences safe to show a member, most actionable first.
  observations Json
  computedAt DateTime @default(now())

  bunch Bunch @relation(fields: [bunchId], references: [id], onDelete: Cascade)

  @@index([computedAt])
}

// ---------------------------------------------------------------------------
// Social plans, icebreakers and challenges
// ---------------------------------------------------------------------------

enum SocialPlanStatus {
  OPEN
  /// A time was chosen. `activityId` points at what it became.
  DECIDED
  CANCELLED
}

/// "When suits everyone?", a few candidate times and a vote.
///
/// Deliberately not a poll engine. There are no arbitrary options, only
/// datetimes, because the one question this answers is when a group can meet.
/// A general poll would be a different feature with different moderation
/// problems, and this is not a quiet way to get one.
model SocialPlan {
  id          String           @id @default(cuid())
  bunchId     String
  createdById String?
  title       String
  note        String?
  status      SocialPlanStatus @default(OPEN)
  /// Set when the plan is decided; the option that won.
  decidedOptionId String?
  /// The activity it turned into. Creating one is an explicit second step,
  /// §10 is clear that nothing is booked or committed automatically.
  activityId  String?          @unique
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  bunch     Bunch              @relation(fields: [bunchId], references: [id], onDelete: Cascade)
  createdBy Profile?           @relation("PlanCreator", fields: [createdById], references: [id], onDelete: SetNull)
  activity  Activity?          @relation(fields: [activityId], references: [id], onDelete: SetNull)
  options   SocialPlanOption[]

  @@index([bunchId, status])
}

model SocialPlanOption {
  id       String   @id @default(cuid())
  planId   String
  startsAt DateTime
  /// How the member described it, e.g. "Saturday afternoon". Optional, the
  /// datetime is the truth, this is only how it reads.
  label    String?

  plan  SocialPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  votes SocialPlanVote[]

  @@index([planId])
}

/// Three answers rather than two.
///
/// "Maybe" is how people actually reply to "can you make Saturday", and
/// collapsing it into a no loses the difference between a group that cannot
/// meet and one that has not decided.
enum PlanVoteResponse {
  YES
  MAYBE
  NO
}

model SocialPlanVote {
  optionId  String
  profileId String
  response  PlanVoteResponse
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  option  SocialPlanOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  profile Profile          @relation("PlanVoter", fields: [profileId], references: [id], onDelete: Cascade)

  @@id([optionId, profileId])
  @@index([profileId])
}

/// Which icebreaker questions a bunch has already had.
///
/// Exists so questions do not repeat, and for nothing else. The *answers* are
/// ordinary chat messages, which is the whole design: §11 says not to build
/// permanent personality profiles out of casual answers, and the way to
/// guarantee that is to have nowhere to put them. An answer here is deleted,
/// exported and moderated exactly like anything else somebody typed.
model IcebreakerAsk {
  id        String   @id @default(cuid())
  bunchId   String
  /// Stable key from the question bank, so it is not asked twice.
  questionKey String
  askedById String?
  askedAt   DateTime @default(now())

  bunch   Bunch    @relation(fields: [bunchId], references: [id], onDelete: Cascade)
  askedBy Profile? @relation("IcebreakerAsker", fields: [askedById], references: [id], onDelete: SetNull)

  @@unique([bunchId, questionKey])
  @@index([bunchId, askedAt])
}

enum ChallengeStatus {
  ACTIVE
  DONE
  /// Put down without finishing. Not a failure and never counted as one.
  DROPPED
}

/// An optional thing a bunch decided to do together.
///
/// Note what is absent: no points, no streak, no expiry, no leaderboard, and
/// no per-member completion. §12 asks for challenges that encourage
/// interaction rather than addiction, and every one of those fields is a
/// mechanism for the opposite. A challenge is active or it is not.
model BunchChallenge {
  id          String          @id @default(cuid())
  bunchId     String
  /// Key from the challenge bank.
  challengeKey String
  status      ChallengeStatus @default(ACTIVE)
  startedById String?
  startedAt   DateTime        @default(now())
  endedAt     DateTime?

  bunch     Bunch    @relation(fields: [bunchId], references: [id], onDelete: Cascade)
  startedBy Profile? @relation("ChallengeStarter", fields: [startedById], references: [id], onDelete: SetNull)

  @@index([bunchId, status])
}

/// Somebody who asked to be told when Bunchy opens.
///
/// Deliberately the smallest table in the schema. An email and a timestamp is
/// everything needed to send one message on launch day, so it is everything
/// that gets stored: no name, no IP, no referrer, no marketing profile. The
/// coming-soon page says as much in plain words, and this model is what makes
/// that promise checkable rather than a claim.
/// An address we have been told to stop writing to.
///
/// Fed by the provider's bounce and complaint webhook, and consulted before
/// every send. A hard bounce means the mailbox does not exist and never will,
/// and continuing to write to it is how a sending domain acquires a reputation
/// for writing to addresses that do not exist. A complaint is somebody
/// pressing "report spam", which is a stronger instruction than any preference
/// screen and is honoured as one.
model EmailSuppression {
  id        String              @id @default(cuid())
  /// Lowercased on write, matching how addresses are stored everywhere else.
  email     String              @unique
  reason    EmailSuppressionReason
  /// The provider's own description, for working out what happened later.
  detail    String?
  createdAt DateTime            @default(now())

  @@index([createdAt])
}

enum EmailSuppressionReason {
  /// The mailbox does not exist, or the domain refuses us permanently.
  BOUNCE
  /// The recipient pressed "report spam".
  COMPLAINT
}

model WaitlistSignup {
  id         String    @id @default(cuid())
  /// Lowercased on write, so one person cannot occupy three rows.
  email      String    @unique
  createdAt  DateTime  @default(now())
  /// When the launch announcement went out. The launch script sends only to
  /// rows where this is null, which is what makes an interrupted run safe to
  /// restart without writing to the same person twice.
  notifiedAt DateTime?

  @@index([createdAt])
  @@index([notifiedAt])
}

/// How far an announcement reaches. The tier picks the route, in code, see
/// `DELIVERY` in the announcements service, so nobody can push a feature note
/// to everybody by ticking the wrong box.
enum AnnouncementTier {
  /// Something changed that affects your rights, your data, or whether the site
  /// is up. Shown as a banner until dismissed, and the only tier that may mail.
  CRITICAL
  /// Worth knowing, not worth interrupting for. Appears on What's new and on the
  /// board, and pushes nothing.
  NOTABLE
  /// On the record. Archive only.
  NOTED
}

/// Something the operator did that affects you.
///
/// This exists because the policies already promise it. Privacy §14 says a
/// change to what we hold "will tell you in the product before it takes
/// effect, not with a quiet edit and a new date at the top", and Terms §14
/// promises the same for anything that materially affects your rights. Neither
/// was implementable before this table existed.
///
/// That promise is what shapes the columns: `effectiveAt` is separate from
/// `publishedAt` so "before it takes effect" is a constraint the code can check
/// rather than an intention, and reads are recorded per member so a banner can
/// retire itself instead of nagging.
model Announcement {
  id      String @id @default(cuid())
  slug    String @unique
  title   String
  /// What changed, in one or two sentences, in plain words.
  summary String
  /// Body blocks: a small tagged union, rendered to React elements and never
  /// to HTML, so an announcement cannot carry markup however it was written.
  body    Json

  tier AnnouncementTier

  /// Where to read the thing this is about, usually a policy page.
  linkHref  String?
  linkLabel String?

  /// Null while it is a draft. A date in the future is a scheduled publish:
  /// every read filters on `publishedAt <= now`, so the row can sit here fully
  /// written and invisible until its moment.
  publishedAt DateTime?
  /// When the change takes effect. Never earlier than `publishedAt`, which is
  /// the whole point of telling people first.
  effectiveAt DateTime?

  /// Whether this belongs on the signed-out changelog.
  ///
  /// A policy change is exactly the thing somebody deciding whether to join
  /// should be able to read before they join, so the default is true. An
  /// announcement about the inside of the product, such as a bunch feature or
  /// a scheduled outage that only affects people already here, is held back by
  /// turning this off, and stays on the member-facing record either way.
  publicVisible Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reads  AnnouncementRead[]
  emails AnnouncementEmail[]

  @@index([publishedAt])
  @@index([tier, publishedAt])
  @@index([publicVisible, publishedAt])
}

/// Who has seen it. Dismissing a banner is the same act as reading it.
model AnnouncementRead {
  announcementId String
  profileId      String
  readAt         DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  profile      Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([announcementId, profileId])
  @@index([profileId])
}

/// Which announcement email has already gone to whom.
///
/// Written *after* a successful send, one row per recipient, so the delivery
/// job is resumable: it selects the members with no row and picks up exactly
/// where a crash or a timeout left it. That is also why the primary key is the
/// three parts together: the same announcement legitimately sends twice, once
/// as notice and once as a reminder before the effective date, and those must
/// not collide.
///
/// Never deleted. "Were we told?" is a question a member is entitled to ask
/// about a change to their rights, and this is the only row that answers it.
model AnnouncementEmail {
  announcementId String
  profileId      String
  kind           AnnouncementEmailKind
  sentAt         DateTime              @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  profile      Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([announcementId, profileId, kind])
  @@index([profileId])
}

/// The two moments an announcement is allowed to reach somebody's inbox.
enum AnnouncementEmailKind {
  /// When it is published. The notice itself.
  NOTICE
  /// Shortly before `effectiveAt`, for a change that has not landed yet.
  REMINDER
}

/// Where a supporter's subscription is, as Stripe last told us.
enum SupporterStatus {
  ACTIVE
  /// Payment failed and Stripe is retrying. Still a supporter, for now.
  PAST_DUE
  /// Cancelled, or the retries ran out. Kept as a row: somebody who supported
  /// this for a year and stopped is not the same as somebody who never did.
  ENDED
}

/// Somebody paying to keep Bunchy running.
///
/// What this row grants is exhaustively cosmetic: a badge, a ring on an avatar,
/// a choice of app icon. Nothing here is read by the matching engine, by
/// notifications, by rate limits or by moderation, and the /about page promises
/// in as many words that a tier making the matching better for people who pay
/// would break the only thing this product is for.
///
/// Stripe holds the money and the truth about it. This table holds only what
/// the product needs to draw a badge and to send somebody to the right billing
/// page, which is why there is no card data, no amount and no invoice here.
model Supporter {
  userId String @id

  /// Stripe's customer, so the billing portal opens on the right account.
  stripeCustomerId     String  @unique
  stripeSubscriptionId String? @unique

  status SupporterStatus @default(ENDED)

  /// When the paid-up period runs out. A cancelled subscription keeps its
  /// cosmetics until this passes, because they were paid for.
  currentPeriodEnd DateTime?
  /// Cancelled, but still inside the period they paid for.
  cancelAtPeriodEnd Boolean @default(false)

  /// The first time they ever supported. Never reset by a cancellation.
  since DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}
