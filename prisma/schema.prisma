// Bunchy — database schema
//
// Design notes
// ------------
// 1. PII SEPARATION. `User` holds everything that identifies a real human
//    (email, password hash, birth year, auth material). `Profile` holds only
//    data that is safe to render to another member. Nothing in the discovery
//    surface reads from `User`. See src/server/modules/profile/serialize.ts —
//    it is the single sanctioned path from a database row to a public payload.
//
// 2. APPROXIMATE LOCATION ONLY. We never store a street address or precise
//    coordinates. `approxLat`/`approxLng` are snapped to a coarse grid
//    (see src/server/modules/geo/precision.ts) so distance-based matching
//    works without ever knowing where someone lives.
//
// 3. INTEREST INTENT. `UserInterest.intent` distinguishes "I already do this"
//    from "I want to get into this". This is what makes complementary matching
//    possible (experienced photographer <-> aspiring photographer) rather than
//    naive shared-tag counting.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity & authentication  (private — never serialized to other members)
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  /// Temporary, set by a moderator. `suspendedUntil` may be null for indefinite.
  SUSPENDED
  /// Permanent, set by an admin. Distinct from SUSPENDED so the two are
  /// separately auditable and separately reversible.
  BANNED
  /// The member deactivated themselves. Reversible by signing back in.
  DEACTIVATED
}

/// Staff privilege. Lives on `User` rather than `Profile` because it is
/// authorization data, never something another member can see.
enum UserRole {
  MEMBER
  /// Can work the report queue and act on content.
  MODERATOR
  /// Everything a moderator can do, plus users, roles and platform settings.
  ADMIN
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  emailVerifiedAt DateTime?
  /// Null for OAuth-only accounts. Never stores a plaintext password.
  passwordHash    String?
  /// Year only. Full dates of birth are more identifying than we need.
  birthYear       Int?
  status          UserStatus @default(ACTIVE)
  role            UserRole   @default(MEMBER)
  /// When a suspension lifts. Null on an indefinite suspension.
  suspendedUntil  DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  profile            Profile?
  sessions           Session[]
  oauthAccounts      OAuthAccount[]
  verificationTokens VerificationToken[]
  moderationActions  ModerationEvent[]   @relation("ModerationActor")

  @@index([status])
  @@index([role])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Staff audit trail
// ---------------------------------------------------------------------------

enum ModerationAction {
  USER_SUSPENDED
  USER_UNSUSPENDED
  USER_BANNED
  USER_UNBANNED
  USER_ROLE_CHANGED
  REPORT_ACTIONED
  REPORT_DISMISSED
  REPORT_REVIEWING
  BUNCH_ARCHIVED
  BUNCH_RESTORED
  ACTIVITY_CANCELLED
  BUNCH_MESSAGE_REMOVED
  INTEREST_APPROVED
  INTEREST_REJECTED
  INTEREST_UPDATED
  INTEREST_MERGED
}

/// Every staff action, recorded before it is taken.
///
/// Moderation power without an audit trail is how a platform quietly becomes
/// unaccountable, so nothing in the admin module mutates state without writing
/// one of these first. The actor is denormalized alongside the foreign key so
/// the record survives the staff account being deleted.
model ModerationEvent {
  id          String           @id @default(cuid())
  action      ModerationAction
  actorUserId String?
  /// Who did it, captured at the time. Survives account deletion.
  actorLabel  String
  targetType  String
  targetId    String
  reason      String?
  /// Free-form context: previous values, counts, merge targets.
  metadata    Json?
  createdAt   DateTime         @default(now())

  actor User? @relation("ModerationActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId])
  @@index([targetType, targetId])
  @@index([action])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  /// SHA-256 of the opaque session token. The raw token exists only in the
  /// user's cookie, so a database leak does not hand out live sessions.
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  userAgent  String?
  /// Hashed, never the raw IP.
  ipHash     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model VerificationToken {
  id         String              @id @default(cuid())
  userId     String
  purpose    VerificationPurpose
  tokenHash  String              @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Public profile
// ---------------------------------------------------------------------------

enum OnboardingStage {
  BASICS
  INTERESTS
  PERSONALITY
  GOALS
  AVAILABILITY
  COMPLETE
}

model Profile {
  id          String  @id @default(cuid())
  userId      String  @unique
  username    String  @unique
  displayName String
  bio         String?
  avatarUrl   String?

  // Approximate location. `cityLabel` is a populated-place label such as
  // "Antwerp", never a street. Coordinates are grid-snapped.
  countryCode String?
  regionLabel String?
  cityLabel   String?
  approxLat   Float?
  approxLng   Float?

  onboardingStage OnboardingStage @default(BASICS)
  onboardedAt     DateTime?
  lastActiveAt    DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  personality  PersonalityProfile?
  privacy      PrivacySettings?
  interests    UserInterest[]
  goals        ProfileSocialGoal[]
  availability ProfileAvailability[]

  sentConnections     Connection[] @relation("ConnectionRequester")
  receivedConnections Connection[] @relation("ConnectionAddressee")

  conversations    ConversationParticipant[]
  directMessages   DirectMessage[]
  bunchMemberships BunchMembership[]
  bunchMessages   BunchMessage[]
  createdBunches   Bunch[]                  @relation("BunchCreator")
  reactions        MessageReaction[]
  mentions         MessageMention[]

  organizedActivities Activity[]            @relation("ActivityOrganizer")
  activityEntries     ActivityParticipant[]

  blocksMade     Block[] @relation("Blocker")
  blocksReceived Block[] @relation("Blocked")
  reportsMade    Report[] @relation("Reporter")
  reportsAbout   Report[] @relation("ReportedProfile")

  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  recommendations         Recommendation[]      @relation("RecommendationOwner")
  matchFeedbackGiven      MatchFeedback[]       @relation("FeedbackAuthor")
  matchFeedbackReceived   MatchFeedback[]       @relation("FeedbackSubject")

  @@index([cityLabel])
  @@index([countryCode, regionLabel])
  @@index([lastActiveAt])
  @@index([onboardingStage])
}

/// Seven lightweight axes, each 0-100. Collected through a handful of
/// either/or questions during onboarding, never presented as a personality test.
model PersonalityProfile {
  profileId String @id

  /// 0 = strongly introvert, 100 = strongly extrovert
  introversionExtraversion Int @default(50)
  /// 0 = spontaneous, 100 = planned
  spontaneityPlanning      Int @default(50)
  /// 0 = competitive, 100 = relaxed
  competitiveRelaxed       Int @default(50)
  /// 0 = deep conversation, 100 = casual conversation
  deepCasual               Int @default(50)
  /// 0 = online-first, 100 = offline-first
  onlineOffline            Int @default(50)
  /// 0 = small groups, 100 = large groups
  smallLargeGroups         Int @default(50)
  /// 0 = night owl, 100 = morning person
  nightMorning             Int @default(50)

  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

enum AudienceScope {
  EVERYONE
  CONNECTIONS
  BUNCH_MEMBERS
  NOBODY
}

model PrivacySettings {
  profileId String @id

  whoCanMessage        AudienceScope @default(CONNECTIONS)
  whoCanSendRequests   AudienceScope @default(EVERYONE)
  /// When false the profile is hidden from Discover entirely.
  discoverable         Boolean       @default(true)
  /// When false we show country/region only, never the city label.
  showApproxLocation   Boolean       @default(true)
  invitableToBunches   Boolean       @default(true)
  /// When false the profile renders an age band ("25-34") instead of an age.
  showExactAge         Boolean       @default(true)

  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Interests, goals, availability
// ---------------------------------------------------------------------------

enum InterestStatus {
  /// Part of the curated catalog, or reviewed and kept.
  APPROVED
  /// Member-created and not yet reviewed. Usable, but not suggested to others.
  PENDING
  /// Reviewed and rejected. Hidden from pickers and browsing.
  REJECTED
}

model Interest {
  id       String  @id @default(cuid())
  slug     String  @unique
  label    String
  category String
  /// Shown in the picker to explain what a tag actually covers.
  description String?
  /// Alternative spellings, so "boardgames" finds "Board games".
  aliases  String[] @default([])
  /// Custom interests are member-created and start unverified.
  isCustom Boolean @default(false)
  status   InterestStatus @default(APPROVED)
  /// Denormalized popularity counter, used to surface established tags first.
  usageCount Int   @default(0)
  createdAt DateTime @default(now())

  users   UserInterest[]
  bunches BunchInterest[]

  @@index([category])
  @@index([usageCount])
  @@index([status])
}

enum InterestIntent {
  /// "I already do this."
  PRACTICES
  /// "I want to get into this." — the other half of complementary matching.
  CURIOUS
}

model UserInterest {
  profileId  String
  interestId String
  /// 1 = casual, 2 = into it, 3 = it's my thing
  strength   Int            @default(2)
  intent     InterestIntent @default(PRACTICES)
  createdAt  DateTime       @default(now())

  profile  Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([profileId, interestId])
  @@index([interestId])
  @@index([profileId, intent])
}

enum SocialGoal {
  NEW_FRIENDS
  GAMING_FRIENDS
  HOBBY_PARTNERS
  GOING_OUT
  STUDY_PARTNERS
  FITNESS_PARTNERS
  CREATIVE_COLLABORATORS
  BUSINESS_PARTNERS
  MENTORS
  SIMILAR_INTERESTS
  LOCAL_COMMUNITIES
  TRAVEL_COMPANIONS
  ACTIVITY_PARTNERS
}

model ProfileSocialGoal {
  profileId String
  goal      SocialGoal

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, goal])
  @@index([goal])
}

enum AvailabilityWindow {
  WEEKDAY_MORNING
  WEEKDAY_AFTERNOON
  WEEKDAY_EVENING
  WEEKEND_MORNING
  WEEKEND_AFTERNOON
  WEEKEND_EVENING
  LATE_NIGHT
}

model ProfileAvailability {
  profileId String
  window    AvailabilityWindow

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, window])
  @@index([window])
}

// ---------------------------------------------------------------------------
// Connections (mutual consent) and direct messaging
// ---------------------------------------------------------------------------

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

model Connection {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      ConnectionStatus @default(PENDING)
  /// Optional short note attached to the request. Rate limited, length capped.
  note        String?
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  requester Profile @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee Profile @relation("ConnectionAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  conversation Conversation?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

model Conversation {
  id            String   @id @default(cuid())
  connectionId  String?  @unique
  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  connection   Connection?               @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     DirectMessage[]

  @@index([lastMessageAt])
}

model ConversationParticipant {
  conversationId String
  profileId      String
  lastReadAt     DateTime?
  joinedAt       DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  profile      Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([conversationId, profileId])
  @@index([profileId])
}

model DirectMessage {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       Profile      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

// ---------------------------------------------------------------------------
// Bunches
// ---------------------------------------------------------------------------

enum BunchType {
  INTEREST
  LOCAL
  ACTIVITY
}

enum BunchVisibility {
  /// Discoverable; joining creates a request a moderator approves.
  PUBLIC
  /// Invite only, hidden from Discover.
  PRIVATE
}

enum BunchRole {
  MEMBER
  MODERATOR
  OWNER
}

enum MembershipStatus {
  ACTIVE
  /// Member asked to join, awaiting moderator approval.
  REQUESTED
  /// Moderator invited them, awaiting their acceptance.
  INVITED
  LEFT
  REMOVED
}

model Bunch {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  description String
  imageUrl    String?
  type        BunchType       @default(INTEREST)
  visibility  BunchVisibility @default(PUBLIC)

  countryCode String?
  regionLabel String?
  cityLabel   String?
  approxLat   Float?
  approxLng   Float?

  /// Bunches are deliberately small. Enforced in the membership service.
  maxMembers Int     @default(12)
  rules      String?

  createdById String?
  /// Rolling 0-1 measure of how alive the bunch is. Recomputed, never shown
  /// as a leaderboard rank.
  activityScore Float    @default(0)
  archivedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy   Profile?           @relation("BunchCreator", fields: [createdById], references: [id], onDelete: SetNull)
  interests   BunchInterest[]
  memberships BunchMembership[]
  messages    BunchMessage[]
  activities  Activity[]

  @@index([visibility, archivedAt])
  @@index([cityLabel])
  @@index([type])
  @@index([activityScore])
}

model BunchInterest {
  bunchId   String
  interestId String

  bunch   Bunch   @relation(fields: [bunchId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([bunchId, interestId])
  @@index([interestId])
}

model BunchMembership {
  bunchId  String
  profileId String
  role      BunchRole       @default(MEMBER)
  status    MembershipStatus @default(ACTIVE)
  joinedAt  DateTime         @default(now())
  lastReadAt DateTime?

  bunch  Bunch  @relation(fields: [bunchId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([bunchId, profileId])
  @@index([profileId, status])
  @@index([bunchId, status])
}

enum BunchMessageKind {
  TEXT
  /// "Ana joined the bunch", "Activity scheduled" — rendered differently,
  /// never notified as if a person spoke.
  SYSTEM
}

model BunchMessage {
  id       String            @id @default(cuid())
  bunchId String
  authorId String?
  kind     BunchMessageKind @default(TEXT)
  body     String
  parentId String?
  createdAt DateTime         @default(now())
  editedAt  DateTime?
  deletedAt DateTime?
  /// Set when a moderator removes the message.
  moderatedAt DateTime?

  bunch    Bunch            @relation(fields: [bunchId], references: [id], onDelete: Cascade)
  author    Profile?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parent    BunchMessage?    @relation("MessageReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies   BunchMessage[]   @relation("MessageReplies")
  reactions MessageReaction[]
  mentions  MessageMention[]

  @@index([bunchId, createdAt])
  @@index([parentId])
  @@index([authorId])
}

model MessageReaction {
  messageId String
  profileId String
  emoji     String
  createdAt DateTime @default(now())

  message BunchMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  profile Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([messageId, profileId, emoji])
  @@index([profileId])
}

model MessageMention {
  messageId String
  profileId String

  message BunchMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  profile Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([messageId, profileId])
  @@index([profileId])
}

// ---------------------------------------------------------------------------
// Activities — the point of the product is that people actually do things
// ---------------------------------------------------------------------------

enum ActivityMode {
  ONLINE
  OFFLINE
}

enum ActivityStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

model Activity {
  id          String         @id @default(cuid())
  title       String
  description String
  startsAt    DateTime
  endsAt      DateTime?
  mode        ActivityMode   @default(OFFLINE)
  /// Venue-level label only ("Bar Bassin, Antwerp"), never a home address.
  locationLabel String?
  countryCode   String?
  cityLabel     String?
  /// For ONLINE activities: where to meet (Discord, Steam, a link).
  onlineUrl     String?
  maxParticipants Int          @default(8)
  status          ActivityStatus @default(SCHEDULED)
  organizerId     String
  bunchId        String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organizer    Profile               @relation("ActivityOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  bunch       Bunch?               @relation(fields: [bunchId], references: [id], onDelete: SetNull)
  participants ActivityParticipant[]

  @@index([startsAt, status])
  @@index([bunchId])
  @@index([organizerId])
  @@index([cityLabel, startsAt])
}

enum ParticipationStatus {
  JOINED
  WAITLISTED
  LEFT
}

model ActivityParticipant {
  activityId String
  profileId  String
  status     ParticipationStatus @default(JOINED)
  joinedAt   DateTime            @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  profile  Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([activityId, profileId])
  @@index([profileId, status])
  @@index([activityId, status])
}

// ---------------------------------------------------------------------------
// Trust & safety
// ---------------------------------------------------------------------------

model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker Profile @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked Profile @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

enum ReportTargetType {
  PROFILE
  BUNCH_MESSAGE
  DIRECT_MESSAGE
  BUNCH
  ACTIVITY
}

enum ReportReason {
  HARASSMENT
  SPAM
  HATE_SPEECH
  SEXUAL_CONTENT
  SCAM_OR_FRAUD
  IMPERSONATION
  SELF_HARM
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  ACTIONED
  DISMISSED
}

model Report {
  id         String           @id @default(cuid())
  reporterId String
  targetType ReportTargetType
  targetId   String
  /// Denormalized for profile reports so moderators can act without a join.
  reportedProfileId String?
  reason     ReportReason
  details    String?
  status     ReportStatus     @default(OPEN)
  createdAt  DateTime         @default(now())
  reviewedAt DateTime?
  reviewNote String?

  reporter        Profile  @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedProfile Profile? @relation("ReportedProfile", fields: [reportedProfileId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId])
  @@index([reportedProfileId])
}

/// Fixed-window rate limit counters. The store is behind an interface
/// (src/server/ratelimit) so this can move to Redis without touching callers.
model RateLimitCounter {
  key         String
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime

  @@id([key, windowStart])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

enum NotificationType {
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  DIRECT_MESSAGE
  BUNCH_INVITE
  BUNCH_JOIN_REQUEST
  BUNCH_MESSAGE_REPLY
  BUNCH_MENTION
  BUNCH_RECOMMENDATION
  ACTIVITY_INVITE
  ACTIVITY_REMINDER
  ACTIVITY_CHANGED
}

model Notification {
  id        String           @id @default(cuid())
  profileId String
  type      NotificationType
  title     String
  body      String?
  linkPath  String?
  /// Collapses duplicates: one "3 new messages" row, not three rows.
  groupKey  String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, readAt, createdAt])
  @@index([profileId, groupKey])
}

model NotificationPreference {
  profileId String
  type      NotificationType
  inApp     Boolean          @default(true)
  email     Boolean          @default(false)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, type])
}

// ---------------------------------------------------------------------------
// Matching output & feedback
// ---------------------------------------------------------------------------

enum RecommendationKind {
  PERSON
  BUNCH
  ACTIVITY
}

model Recommendation {
  id        String             @id @default(cuid())
  profileId String
  kind      RecommendationKind
  targetId  String
  score     Float
  /// Human-readable signal breakdown from the scorer, kept so we can explain
  /// a recommendation and audit scorer changes over time.
  reasons   Json
  /// Identifies which scorer produced this ("deterministic@1", "llm@...").
  source    String
  createdAt DateTime           @default(now())
  expiresAt DateTime
  dismissedAt DateTime?
  actedAt     DateTime?

  profile Profile @relation("RecommendationOwner", fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, kind, targetId])
  @@index([profileId, kind, score])
  @@index([expiresAt])
}

enum MatchFeedbackSignal {
  GOOD_MATCH
  NOT_INTERESTED
}

/// Explicit "this was/wasn't a good suggestion" feedback. Feeds straight back
/// into scoring, and is the training set for a future learned ranker.
model MatchFeedback {
  id        String              @id @default(cuid())
  profileId String
  targetId  String
  signal    MatchFeedbackSignal
  createdAt DateTime            @default(now())

  profile Profile @relation("FeedbackAuthor", fields: [profileId], references: [id], onDelete: Cascade)
  target  Profile @relation("FeedbackSubject", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([profileId, targetId])
  @@index([targetId])
}
