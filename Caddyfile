# Bunchy, TLS termination and reverse proxy.
#
# Caddy is here rather than nginx for one reason: certificates. It obtains and
# renews them from Let's Encrypt automatically, with no certbot, no cron entry
# and no renewal that quietly stops working in ninety days. For a platform run
# by one person that is the difference between TLS that keeps working and TLS
# that expires on a Sunday.

{
	email {$TLS_EMAIL}
	# Uncomment to test against the staging CA, which has far looser rate
	# limits. Certificates it issues are not trusted by browsers, use it while
	# getting DNS right, then comment it out again.
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# www exists, and goes exactly one place.
#
# Both hostnames used to serve the same site from the same block, which means a
# crawler could reach every page at two addresses and had no way to know which
# was canonical, the textbook duplicate-content split, where the two versions
# divide whatever authority the page earns instead of accumulating it. A 301 is
# the unambiguous answer, and it is permanent so it is cached as such.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip

	# HSTS. Deliberately not preloaded: preloading is close to irreversible,
	# and it should be a decision taken once the domain is settled rather than
	# something a deploy config does to you.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# The app sets its own X-Frame-Options, nosniff, Referrer-Policy and
		# Permissions-Policy in next.config.ts. They are not duplicated here,
		# two places setting the same header is how they end up disagreeing.
		-Server
	}

	# Next emits content-hashed filenames under this path, so they can be
	# cached hard. Nothing else can: every page depends on who is signed in.
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# --- Manual gate ---------------------------------------------------------
	#
	# Two switches, flipped by ./maintenance.sh, which just creates or removes a
	# flag file in the mounted flags directory. A file rather than an
	# environment variable so that turning the site off does not require
	# restarting the thing that serves the "off" page.
	#
	#   flags/SOON, pre-launch. The site is finished enough to be private and
	#                 not finished enough to be public.
	#   flags/ON, maintenance. Deliberate, longer than a deploy.
	#
	# Both are bypassed by a preview cookie, because a switch that also locks
	# out the person who flipped it is a switch nobody can safely use. Visiting
	# /?preview=$PREVIEW_TOKEN once sets the cookie for thirty days.

	# Hand out the cookie, then bounce to the same path without the token in the
	# URL, so a shared screenshot or a browser history entry does not leak it.
	@preview_grant query preview={$PREVIEW_TOKEN}
	handle @preview_grant {
		header Set-Cookie "bunchy_preview={$PREVIEW_TOKEN}; Path=/; Max-Age=2592000; HttpOnly; Secure; SameSite=Lax"
		redir {path} 302
	}

	# Giving it back, for testing the gate from your own browser.
	@preview_revoke query preview=off
	handle @preview_revoke {
		header Set-Cookie "bunchy_preview=; Path=/; Max-Age=0; HttpOnly; Secure; SameSite=Lax"
		redir {path} 302
	}

	@holder header_regexp Cookie bunchy_preview={$PREVIEW_TOKEN}

	@soon {
		file {
			root /srv/flags
			try_files SOON
		}
		not header_regexp Cookie bunchy_preview={$PREVIEW_TOKEN}
		# The brand assets stay reachable while the gate is up. A browser
		# fetches the manifest without credentials, so even a previewer got a
		# 503 and a console error, and, worse, the Open Graph image was gated
		# too, which meant every link to bunchy.app shared privately before
		# launch previewed as broken. None of these say anything the
		# coming-soon page does not already say out loud.
		# Next's own asset paths have to reach the app, or the page the gate
		# serves arrives without its stylesheet.
		# Unsubscribing has to work while the gate is up. A link in an email
		# that was already sent must not answer with the coming-soon page: to
		# the reader that is a broken unsubscribe, and the next lever they
		# reach for is the spam button.
		#
		# The privacy notice and the terms are here for the same reason the
		# waitlist endpoint is: the coming-soon page collects an email address,
		# and a notice describing what happens to it has to be readable at the
		# moment it is given, not after launch. A form that takes personal data
		# while the document explaining it answers 503 is the one thing on this
		# page that was actually a compliance problem rather than a rough edge.
		#
		# /sitemap.xml is here because /robots.txt is. Serving the rules and
		# refusing the sitemap they name is a crawler being sent to a 503 by us,
		# on purpose, which is worse than not mentioning it at all.
		#
		# /api/health is here so that monitoring from outside the host sees the
		# app rather than the gate. The container check reaches the app directly
		# on 127.0.0.1 and so has always been honest; anything checking the
		# public URL was reading a deliberate 503 as a permanent outage, which
		# is exactly the alarm you need to still mean something on launch day.
		#
		# The three language spellings of every page that is let through. A
		# reader whose language is Dutch is redirected from /privacy to
		# /nl/privacy by the app, and a list that only knows the English
		# address would answer that redirect with the coming-soon page: the
		# notice would be readable in one language and gated in the other two,
		# which is the compliance problem this list exists to avoid, wearing a
		# different hat.
		not path /icon.svg /favicon.ico /apple-icon.png /manifest.webmanifest /opengraph-image /robots.txt /sitemap.xml /_next/* /api/waitlist /api/unsubscribe /unsubscribe /nl/unsubscribe /fr/unsubscribe /api/health /api/webhooks/* /privacy /nl/privacy /fr/privacy /terms /nl/terms /fr/terms
	}
	handle @soon {
		# Rewritten to the real page rather than a static file. The coming-soon
		# gate is flipped deliberately while the app is running, unlike
		# maintenance, which exists for when it is not. So this one can have a
		# working form, a server-rendered count, the app's stylesheet and a CSP.
		# If the app does fall over while the gate is up, handle_errors below
		# still catches it and serves the static maintenance page.
		#
		# Rewritten into the language the address asked for, not always into
		# English. Rewriting every address to the bare /coming-soon would strip
		# the prefix off a Dutch request, the app would notice the language was
		# missing from the address and redirect to put it back, and Caddy would
		# strip it off again: a loop, on the one page that has to work before
		# anybody has an account.
		@soon_nl path /nl /nl/*
		@soon_fr path /fr /fr/*
		@soon_en not path /nl /nl/* /fr /fr/*
		rewrite @soon_nl /nl/coming-soon
		rewrite @soon_fr /fr/coming-soon
		rewrite @soon_en /coming-soon
		reverse_proxy app:3000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			# The app answers 200, as it should. Rewriting it to 503 on the way
			# out is what keeps an unlaunched site out of the index: a crawler
			# that gets a 200 files this away as the site's content, and then
			# the real homepage has to displace it.
			@page status 200
			handle_response @page {
				# `copy_response` alone, with no `copy_response_headers`.
				#
				# The upstream headers are already on the response by the time
				# this block runs, so copying them again appended a second set:
				# every header twice, cache-control three times with different
				# directives, and Connection and Keep-Alive present in an HTTP/2
				# response, which RFC 9113 forbids outright. The app's CSP and
				# security headers survive without any of that, because they
				# were never missing.
				copy_response 503
			}
		}
		# 503 keeps an unlaunched site out of the index. A day is the right
		# Retry-After here: this state lasts weeks, not the two minutes a
		# restart does.
		header Retry-After "86400"
		header Cache-Control "no-store, must-revalidate"
	}

	@maint {
		file {
			root /srv/flags
			try_files ON
		}
		not header_regexp Cookie bunchy_preview={$PREVIEW_TOKEN}
		# The brand assets stay reachable while the gate is up. A browser
		# fetches the manifest without credentials, so even a previewer got a
		# 503 and a console error, and, worse, the Open Graph image was gated
		# too, which meant every link to bunchy.app shared privately before
		# launch previewed as broken. None of these say anything the
		# coming-soon page does not already say out loud.
		not path /icon.svg /favicon.ico /apple-icon.png /manifest.webmanifest /opengraph-image /robots.txt
	}
	handle @maint {
		root * /srv/pages
		rewrite * /maintenance.html
		file_server {
			status 503
		}
		header Retry-After "600"
		header Cache-Control "no-store, must-revalidate"
	}

	reverse_proxy app:3000 {
		# Without this the app sees Caddy's container IP as the client address,
		# which would make rate limiting count the whole internet as one person.
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		health_uri /api/health
		health_interval 30s
	}

	# When the app is unreachable, a deploy, a restart, an outage, serve the
	# maintenance page rather than Caddy's bare error text. Every deploy takes
	# the app down for around twenty seconds, so without this there is a window
	# on every single release where the site says "502 Bad Gateway" to whoever
	# is looking.
	#
	# Only the upstream-is-down statuses are caught. A 404 or a 500 raised *by*
	# the app is the app's own answer and must not be dressed up as maintenance:
	# doing that would hide real errors behind a reassuring page.
	handle_errors {
		@down expression {err.status_code} in [502, 503, 504]
		handle @down {
			root * /srv/pages
			rewrite * /maintenance.html
			# 503, not 200. A maintenance page that returns "OK" tells crawlers
			# the site is fine and this is its content, which is how an outage
			# turns into a de-indexing. Retry-After says how long to wait.
			file_server {
				status 503
			}
			header Retry-After "120"
			header Cache-Control "no-store, must-revalidate"
		}
	}

	log {
		output stdout
		format console
	}
}
