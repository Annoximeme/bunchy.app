{
  "name": "bunchy",
  "version": "0.1.0",
  "private": true,
  "description": "Bunchy \u2014 find your people. An AI-assisted social discovery platform for real friendships, small circles and offline activities.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "role": "node --env-file=.env node_modules/.bin/tsx scripts/grant-role.ts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "verify:all": "npm run verify && npm run test:components && npm run test:integration",
    "jobs": "node --env-file=.env node_modules/.bin/tsx scripts/run-jobs.ts",
    "test:components": "vitest run --config vitest.components.config.mts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "next": "^16.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.25.0",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^30.0.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
